# Manual environment-variable template only — do not copy to .env.local after
# running `npx convex dev --once`; that command generates the correct .env.local values.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# Contact-form email delivery. These live on the Convex deployment, not in .env.local:
#   npx convex env set RESEND_API_KEY re_xxx
#   npx convex env set CONTACT_NOTIFY_EMAIL you@example.com
#   npx convex env set CONTACT_FROM_EMAIL "Party Cat HQ <hello@yourdomain.com>"
# CONTACT_FROM_EMAIL is optional and defaults to onboarding@resend.dev, which
# Resend only allows delivering to the account owner's address.

# Bot verification (Cloudflare Turnstile). Set the secret on Convex; site key is public:
#   npx convex env set TURNSTILE_SECRET_KEY your_secret_key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
